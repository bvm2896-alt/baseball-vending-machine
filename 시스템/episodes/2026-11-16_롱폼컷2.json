 "lines": [
  {
   "narr": "마흔 살을 앞둔 두산 양의지가 / 사십이억을 포기하고 / 에프에이를 신청했어요",
   "sub": "마흔 살을 앞둔\n두산 양의지가|42억을 포기하고|FA를 신청했어요"
  },
  {
   "narr": "양의지는 / 이천이십이년 겨울 두산과 / 사 플러스 이 년, / +최대 백오십이억에 계약했어요",
   "sub": "양의지는|2022년 겨울 두산과|4+2년,|최대 152억에 계약했어요"
  },
  {
   "narr": "앞 사 년 백십억은 / 보장이었고 / 남은 이 년 사십이억은 / +양의지가 고를 수 있었어요",
   "sub": "앞 4년 110억은|보장이었고|남은 2년 42억은|양의지가 고를 수 있었어요"
  },
  {
   "narr": "그런데 그 이 년 대신 / 에프에이 시장에 나왔어요",
   "sub": "그런데 그 2년 대신|FA 시장에 나왔어요"
  },
  {
   "narr": "양의지는 / 에프에이, 씨등급이라 / 보상선수는 없지만 / 데려가는 팀이 / 보상금 육십삼억을 / +줘야 해요",
   "sub": "양의지는|FA C등급이라|보상선수는 없지만|데려가는 팀이|보상금 63억을|줘야 해요"
  },
  {
   "narr": "이천이십육년 연봉도 / 사십이억이라 / 그 백오십 퍼센트가 / +보상금이거든요",
   "sub": "2026년 연봉도|42억이라|그 150%가|보상금이거든요"
  },
  {
   "narr": "옵트아웃으로 / 방출 선수가 돼서 나왔다면 / 보상 없이 / +어느 팀이든 갈 수 있었는데요",
   "sub": "옵트아웃으로|방출 선수가 돼서 나왔다면|보상 없이|어느 팀이든\n갈 수 있었는데요"
  },
  {
   "narr": "그래서 / 에프에이 신청은 / 두산 잔류 결심이라는 / +얘기까지 나와요",
   "sub": "그래서|FA 신청은|두산 잔류 결심이라는|얘기까지 나와요"
  },
  {
   "narr": "다시 맺는 계약이 / 기존 이 년보다 / +클 수 있다는 말도 있어요",
   "sub": "다시 맺는 계약이|기존 2년보다|클 수 있다는 말도 있어요"
  },
  {
   "narr": "이번 시장엔 / 양의지, 박동원, 김태군, 최재훈 / 포수만 네 명이 나왔어요",
   "sub": "이번 시장엔|양의지·박동원\n김태군·최재훈|포수만 4명이 나왔어요"
  },
  {
   "narr": "이천이십이년 겨울처럼 / 포수 대이동이 또 / +벌어질 수 있다는 / +말이 나와요",
   "sub": "2022년 겨울처럼|포수 대이동이 또|벌어질 수 있다는|말이 나와요"
  },
  {
   "narr": "십일월 십칠일부터 / 에프에이 협상이 시작돼요",
